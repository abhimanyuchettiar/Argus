# Copy to .env and set a unique, strong password before starting services.
ARGUS_DB_NAME=argus
ARGUS_DB_USER=postgres
ARGUS_DB_PASSWORD=replace-with-a-unique-strong-password
ARGUS_DB_BIND_ADDRESS=127.0.0.1
ARGUS_API_BIND_ADDRESS=127.0.0.1
ARGUS_LISTENER_BIND_ADDRESS=127.0.0.1
ARGUS_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
